<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:fadeScrollbars="false"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp">

        <!-- 标题 -->
        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dialog_add_key"
            android:textColor="#111827"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDialogSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/dialog_key_subtitle"
            android:textColor="#7C8AA0"
            android:textSize="12sp" />

        <!-- 键位 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/dlg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:letterSpacing="0.06"
                android:text="@string/dialog_key_section_key"
                android:textColor="#7C8AA0"
                android:textSize="11sp" />

            <Spinner
                android:id="@+id/spinnerKey"
                android:layout_width="match_parent"
                android:layout_height="44dp" />

            <LinearLayout
                android:id="@+id/llCustomCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/dialog_key_custom_code_section"
                    android:textColor="#7C8AA0"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etCode"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/dlg_field"
                    android:gravity="center_vertical"
                    android:hint="@string/dialog_key_custom_code_hint"
                    android:inputType="number"
                    android:maxLength="4"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 显示 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/dlg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:letterSpacing="0.06"
                android:text="@string/dialog_key_group_look"
                android:textColor="#7C8AA0"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/etLabel"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/dlg_field"
                android:gravity="center_vertical"
                android:hint="@string/dialog_key_label_hint"
                android:inputType="text"
                android:maxLength="6"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:text="@string/dialog_key_size_section"
                android:textColor="#7C8AA0"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etSize"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/dlg_field"
                    android:gravity="center_vertical"
                    android:hint="@string/dialog_key_size_hint"
                    android:inputType="number"
                    android:maxLength="3"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnSizePreset"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/dlg_chip"
                    android:minWidth="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/dialog_key_size_preset"
                    android:textAllCaps="false"
                    android:textColor="#2F6BFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:text="@string/dialog_key_shape_section"
                android:textColor="#7C8AA0"
                android:textSize="11sp" />

            <Spinner
                android:id="@+id/spinnerShape"
                android:layout_width="match_parent"
                android:layout_height="44dp" />
        </LinearLayout>

        <!-- 行为 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/dlg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:letterSpacing="0.06"
                android:text="@string/dialog_key_group_behavior"
                android:textColor="#7C8AA0"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/cb_one_key"
                    android:textColor="#3C4759"
                    android:textSize="12sp" />

                <Switch
                    android:id="@+id/cbOneKey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="#E8EDF6" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/cb_latch"
                    android:textColor="#3C4759"
                    android:textSize="12sp" />

                <Switch
                    android:id="@+id/cbLatch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 摇杆 -->
        <LinearLayout
            android:id="@+id/llJoystick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/dlg_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/dialog_key_stick_mode_section"
                android:textColor="#7C8AA0"
                android:textSize="11sp" />

            <Spinner
                android:id="@+id/spinnerStickMode"
                android:layout_width="match_parent"
                android:layout_height="44dp" />

            <!-- 鼠标模式下：按住时注入什么（左键 / 右键 / 中键 / 自定义键值） -->
            <LinearLayout
                android:id="@+id/llMouseHold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/dialog_mouse_hold_section"
                    android:textColor="#7C8AA0"
                    android:textSize="11sp" />

                <Spinner
                    android:id="@+id/spinnerMouseHold"
                    android:layout_width="match_parent"
                    android:layout_height="44dp" />

                <EditText
                    android:id="@+id/etMouseHoldCode"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/dlg_field"
                    android:gravity="center"
                    android:hint="@string/hint_mouse_hold_code"
                    android:inputType="number"
                    android:maxLength="3"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:text="@string/dialog_key_stick_dirs_section"
                android:textColor="#7C8AA0"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etStickUp"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/dlg_field"
                    android:gravity="center"
                    android:hint="@string/hint_up"
                    android:inputType="number"
                    android:maxLength="3"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etStickDown"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/dlg_field"
                    android:gravity="center"
                    android:hint="@string/hint_down"
                    android:inputType="number"
                    android:maxLength="3"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etStickLeft"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/dlg_field"
                    android:gravity="center"
                    android:hint="@string/hint_left"
                    android:inputType="number"
                    android:maxLength="3"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etStickRight"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/dlg_field"
                    android:gravity="center"
                    android:hint="@string/hint_right"
                    android:inputType="number"
                    android:maxLength="3"
                    android:textSize="14sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnAnchorCenter"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/dlg_chip"
                android:text="@string/btn_anchor_center"
                android:textAllCaps="false"
                android:textColor="#2F6BFF"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/stick_touch_desc"
                android:textColor="#8A96A8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 注入方式 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/dlg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvInjectTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:letterSpacing="0.06"
                android:text="@string/inject_title"
                android:textColor="#7C8AA0"
                android:textSize="11sp" />

            <RadioGroup
                android:id="@+id/rgType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:minHeight="40dp"
                    android:text="@string/rb_key"
                    android:textColor="#3C4759"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbTouch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:text="@string/rb_touch"
                    android:textColor="#3C4759"
                    android:textSize="12sp" />
            </RadioGroup>

            <TextView
                android:id="@+id/tvInjectHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/inject_hint"
                android:textColor="#8A96A8"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
