<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:fadeScrollbars="false"
    android:scrollbars="vertical">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="4dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dialog_key_section_key"
        android:textColor="#666666"
        android:textSize="13sp" />

    <Spinner
        android:id="@+id/spinnerKey"
        android:layout_width="match_parent"
        android:layout_height="48dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/dialog_key_label_section"
        android:textColor="#666666"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etLabel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="@string/dialog_key_label_hint"
        android:inputType="text"
        android:maxLength="6"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/dialog_key_size_section"
        android:textColor="#666666"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etSize"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="@string/dialog_key_size_hint"
            android:inputType="number"
            android:maxLength="3"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnSizePreset"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:text="@string/dialog_key_size_preset"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/dialog_key_shape_section"
        android:textColor="#666666"
        android:textSize="13sp" />

    <Spinner
        android:id="@+id/spinnerShape"
        android:layout_width="match_parent"
        android:layout_height="48dp" />

    <CheckBox
        android:id="@+id/cbOneKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/cb_one_key"
        android:textSize="13sp" />

    <CheckBox
        android:id="@+id/cbLatch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cb_latch"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/llCustomCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/dialog_key_custom_code_section"
            android:textColor="#666666"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etCode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/dialog_key_custom_code_hint"
            android:inputType="number"
            android:maxLength="4"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llJoystick"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/dialog_key_stick_mode_section"
            android:textColor="#666666"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spinnerStickMode"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/dialog_key_stick_dirs_section"
            android:textColor="#666666"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etStickUp"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="@string/hint_up"
                android:inputType="number"
                android:maxLength="3"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etStickDown"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="@string/hint_down"
                android:inputType="number"
                android:maxLength="3"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etStickLeft"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="@string/hint_left"
                android:inputType="number"
                android:maxLength="3"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etStickRight"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="@string/hint_right"
                android:inputType="number"
                android:maxLength="3"
                android:textSize="15sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnAnchorCenter"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:text="@string/btn_anchor_center"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/stick_touch_desc"
            android:textColor="#999999"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvInjectTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/inject_title"
        android:textColor="#666666"
        android:textSize="13sp" />

    <RadioGroup
        android:id="@+id/rgType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rbKey"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:checked="true"
            android:text="@string/rb_key"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbTouch"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/rb_touch"
            android:textSize="13sp" />
    </RadioGroup>

    <TextView
        android:id="@+id/tvInjectHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/inject_hint"
        android:textColor="#999999"
        android:textSize="12sp" />

</LinearLayout>
</ScrollView>
